# DevDocs AI backend environment variables.
# Copy to .env and fill in real values. Do not commit a real .env file.

# xAI API key for the Grok LLM provider. Will be added later; leave empty for now.
XAI_API_KEY=

# Model used by the xAI provider.
XAI_MODEL=

# Allowed CORS origins for the frontend (comma-separated).
CORS_ORIGINS=http://localhost:5173
