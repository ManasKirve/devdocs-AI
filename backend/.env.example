# DevDocs AI backend environment variables.
# Copy to .env and fill in real values. Do not commit a real .env file.

# xAI API key for the Grok LLM provider (required).
XAI_API_KEY=

# Grok model used by the LLM provider.
XAI_MODEL=grok-4.5

# xAI API base URL (official endpoint).
XAI_BASE_URL=https://api.x.ai/v1

# Request timeout for xAI API calls, in seconds.
XAI_TIMEOUT_SECONDS=60

# Allowed CORS origins for the frontend (JSON array).
CORS_ORIGINS=["http://localhost:5173"]
