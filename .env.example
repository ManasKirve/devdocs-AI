# DevDocs AI - single environment file for the entire project.
# Copy this file to .env and fill in real secrets. Never commit a real .env file.

# Backend
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RAG_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# --- Production (set these in the Vercel / Render dashboards, not in .env) ---
# Vercel  -> VITE_API_BASE_URL=https://devdocs-ai-c462.onrender.com
# Render  -> CORS_ORIGINS=https://devdocs-ai-dun.vercel.app
