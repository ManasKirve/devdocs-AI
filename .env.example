# DevDocs AI - single environment file for the entire project.
# Copy this file to .env and fill in real secrets. Never commit a real .env file.

# Backend
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_EMBEDDING_MODEL=text-embedding-3-large
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# --- Production (set these in the Vercel / Render dashboards, not in .env) ---
# Vercel  -> VITE_API_BASE_URL=https://devdocs-ai-c462.onrender.com
# Render  -> CORS_ORIGINS=https://your-app.vercel.app
